{
  "name": "litellm-usage",
  "displayName": "LiteLLM Usage",
  "description": "Track your LiteLLM proxy spend, token and model usage from VS Code — sign in with SSO, a virtual key or username/password. No admin account required.",
  "version": "0.6.2",
  "publisher": "mesutpiskin",
  "author": {
    "name": "Mesut Pişkin",
    "email": "mesutpiskin@outlook.com"
  },
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e3a8a",
    "theme": "dark"
  },
  "homepage": "https://github.com/mesutpiskin/litellm-usage#readme",
  "bugs": {
    "url": "https://github.com/mesutpiskin/litellm-usage/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mesutpiskin/litellm-usage.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Visualization",
    "Other"
  ],
  "keywords": [
    "budget",
    "cost",
    "google",
    "litellm",
    "llm",
    "openai",
    "spend",
    "sso",
    "tokens",
    "usage"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "litellm.showDashboard",
        "title": "Show Usage Dashboard",
        "category": "LiteLLM",
        "icon": "$(link-external)"
      },
      {
        "command": "litellm.switchAccount",
        "title": "Switch Account",
        "category": "LiteLLM",
        "icon": "$(account)"
      },
      {
        "command": "litellm.addAccount",
        "title": "Add Account",
        "category": "LiteLLM",
        "icon": "$(add)"
      },
      {
        "command": "litellm.renameAccount",
        "title": "Rename Account",
        "category": "LiteLLM"
      },
      {
        "command": "litellm.reauthenticate",
        "title": "Sign In Again (SSO)",
        "category": "LiteLLM",
        "icon": "$(sign-in)"
      },
      {
        "command": "litellm.removeAccount",
        "title": "Remove Account",
        "category": "LiteLLM",
        "icon": "$(trash)"
      },
      {
        "command": "litellm.refresh",
        "title": "Refresh",
        "category": "LiteLLM",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "litellm",
          "title": "LiteLLM Usage",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "litellm": [
        {
          "type": "webview",
          "id": "litellm.usageView",
          "name": "Usage"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "litellm.refresh",
          "when": "view == litellm.usageView",
          "group": "navigation@1"
        },
        {
          "command": "litellm.switchAccount",
          "when": "view == litellm.usageView",
          "group": "navigation@2"
        },
        {
          "command": "litellm.showDashboard",
          "when": "view == litellm.usageView",
          "group": "navigation@3"
        },
        {
          "command": "litellm.addAccount",
          "when": "view == litellm.usageView",
          "group": "account@1"
        },
        {
          "command": "litellm.renameAccount",
          "when": "view == litellm.usageView",
          "group": "account@2"
        },
        {
          "command": "litellm.removeAccount",
          "when": "view == litellm.usageView",
          "group": "account@3"
        }
      ]
    },
    "configuration": {
      "title": "LiteLLM Usage",
      "properties": {
        "litellm.refreshMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Auto-refresh interval in minutes."
        },
        "litellm.statusBar": {
          "type": "string",
          "enum": [
            "todaySpend",
            "todayTokens",
            "totalSpend",
            "icon"
          ],
          "enumDescriptions": [
            "Today's spend",
            "Today's tokens",
            "Total spend",
            "Icon only"
          ],
          "default": "todaySpend",
          "description": "What to show in the status bar."
        },
        "litellm.allowInsecureTLS": {
          "type": "boolean",
          "default": false,
          "description": "Accept self-signed or untrusted TLS certificates (e.g. internal proxies)."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test test/*.test.js",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^3.0.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.5.0"
  }
}
